# Copy to .env. Only PLEX_TOKEN is needed to start.
# Every tool also reads these straight from the environment if you prefer.

# https://support.plex.tv/articles/204059436
PLEX_TOKEN=
PLEX_URL=http://localhost:32400

# MusicBrainz requires a UA naming the app and a contact for whoever runs it.
# SET THIS. The default in the code is a placeholder, deliberately.
MUSICBRAINZ_UA=megafan/1.0 ( https://github.com/vinnybouchard/Megafan )

# Where your ripper leaves its per-disc JSON logs (catalogue number, disc
# number, output byte counts). Optional -- pass --catalog by hand without it.
RIP_LOG_DIR=/mnt/media/STAGING/.dvdrip-logs

# Scans of the physical sleeve. A photo of the back panel outranks every online
# source, so this is checked before the fact table, not after.
CONCERT_SCANS_DIR=~/disc-scans

# --- plex_subs.py only ----------------------------------------------------
# Transcription (the `mc` lane) needs the openai package and a key.
OPENAI_API_KEY=
PLEX_SUBS_MODEL=gpt-5.6-terra
PLEX_SUBS_TRIAGE_MODEL=gpt-5.6-luna

# A local WhisperX install for the ASR pass. cuBLAS/cuDNN commonly ship inside
# that venv rather than on the system loader path, which is what the env file is.
WHISPER_PYTHON=~/whisper/venv/bin/python
WHISPER_CUDA_ENV=~/whisper/cuda-libs.env
SUBS_WORK_ROOT=/mnt/media/.subs-work
